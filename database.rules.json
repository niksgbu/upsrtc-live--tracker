{
  "rules": {
    ".read": false,
    ".write": false,
    "buses": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['busNo','routeId','lat','lng','ts'])",
        "busNo":   { ".validate": "newData.isString() && newData.val().length <= 14" },
        "routeId": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "lat":     { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "lng":     { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "$other":  { ".validate": true }
      }
    }
  }
}
